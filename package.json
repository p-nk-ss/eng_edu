{
  "name": "english-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run db:start",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 setup",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 stop",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 status",
    "db:psql": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db.ps1 psql"
  },
  "dependencies": {
    "next": "15.5.20",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3",
    "lucide-react": "^0.577.0",
    "@prisma/client": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "pg": "^8.13.1",
    "@anthropic-ai/sdk": "^0.110.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.204"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.2.4",
    "prisma": "^7.8.0",
    "tsx": "^4.20.7",
    "tailwindcss": "^3.4.19",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "vitest": "^4.1.10",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3"
  }
}
