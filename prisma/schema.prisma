generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts, not here.
  // Local PostgreSQL — DATABASE_URL serves both runtime (pg adapter, src/lib/db.ts)
  // and migrations (prisma.config.ts). No pooler locally, so no separate DIRECT_URL.
}

enum LessonStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum ExerciseType {
  MULTIPLE_CHOICE
  CLOZE_DROPDOWN
  FILL_BLANK
  WORD_BANK
  MATCH
  DIALOGUE_GAP
  DICTATION
  ERROR_CORRECTION
  TRANSLATION
  OPEN_WRITING
}

enum ErrorSource {
  CONVERSATION
  EXERCISE
  WRITING
}

enum ErrorStatus {
  NEW
  REVIEWING
  MASTERED
}

enum TopicStatus {
  NOT_STARTED
  INTRODUCED
  PRACTICING
  MASTERED
}

enum VocabStatus {
  NEW
  SEEN
  LEARNING
  KNOWN
}

model Profile {
  id              String   @id @default(cuid())
  level           String
  goals           String
  interests       String
  nativeLang      String   @default("ru")
  preferredThemes String[] @default([]) // theme keys from src/lib/curriculum/themes.ts; visited ~2x as often
  updatedAt       DateTime @updatedAt
}

model Lesson {
  id             String             @id @default(cuid())
  date           DateTime           @default(now())
  status         LessonStatus       @default(PLANNED)
  currentSection Int                @default(0)
  theme          String? // theme key of this lesson; drives least-recently-used theme rotation
  plan           Json
  summary        String?
  nextPlan       String?
  exercises      Exercise[]
  turns          ConversationTurn[]
  errors         ErrorRecord[]
}

model Exercise {
  id            String       @id @default(cuid())
  lessonId      String
  lesson        Lesson       @relation(fields: [lessonId], references: [id])
  type          ExerciseType
  content       Json
  userAnswer    String?
  isCorrect     Boolean?
  feedback      String?
  errorRecordId String?
  result        Json? // GradeResult (M3c) - verdict, key, feedback, vocab credit; null until answered
  answeredAt    DateTime? // set once; a second submit returns the stored result
  createdAt     DateTime     @default(now())
}

model ErrorRecord {
  id             String        @id @default(cuid())
  lessonId       String
  lesson         Lesson        @relation(fields: [lessonId], references: [id])
  grammarTopicId String?
  grammarTopic   GrammarTopic? @relation(fields: [grammarTopicId], references: [id])
  category       String
  description    String
  source         ErrorSource
  status         ErrorStatus   @default(NEW)
  correctStreak  Int           @default(0)
  nextReviewAt   DateTime
  createdAt      DateTime      @default(now())
}

model ConversationTurn {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  role        String
  text        String
  corrections Json?
  createdAt   DateTime @default(now())
}

model GrammarTopic {
  id          String        @id @default(cuid())
  name        String        @unique
  cefrLevel   String
  category    String?
  status      TopicStatus   @default(NOT_STARTED)
  timesUsed   Int           @default(0)
  lastUsedAt  DateTime?
  sortOrder   Int
  title       String? // learner-facing title from data/grammar-topics.json (M3b-1); NULL until enriched
  description String?
  example     String?
  teachable   Boolean       @default(true) // false = never selected as a lesson focus, not counted in progress
  importance  Int           @default(2) // 1 core .. 3 peripheral; orders topics inside a level
  errors      ErrorRecord[]
}

model VocabItem {
  id            String      @id @default(cuid())
  headword      String
  pos           String?
  cefrLevel     String
  topic         String?
  isPhrase      Boolean     @default(false)
  status        VocabStatus @default(NEW)
  correctStreak Int         @default(0)
  lastSeenAt    DateTime?

  @@unique([headword, pos])
}
