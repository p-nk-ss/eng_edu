# Neon pooled connection string (host contains `-pooler`) — runtime
DATABASE_URL=
# Neon direct connection string (no `-pooler`) — used by `prisma migrate`
DIRECT_URL=

# Claude Agent SDK (subscription auth) — generate with `claude setup-token`
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY must NOT be set (bills pay-per-token). Only set with LLM_ROLE_*=api.
# ANTHROPIC_API_KEY=

# Local LLM (LM Studio, OpenAI-compatible)
LOCAL_LLM_URL=http://localhost:1234/v1
LOCAL_LLM_MODEL=qwen3-14b

# Local TTS (used from M5)
KOKORO_URL=http://localhost:8880

# Optional per-role provider overrides: local | agent | api
# LLM_ROLE_CONVERSATION=local
# LLM_ROLE_LESSON_GENERATION=agent
